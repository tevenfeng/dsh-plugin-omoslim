{
  "name": "dsh-plugin-omoslim",
  "version": "0.5.2",
  "description": "DeepSeek Harness bundle: oh-my-opencode-slim style Orchestrator agent preset with model-pinned specialist subagents (explorer/oracle/librarian/designer/fixer/council).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "omoslim": "./lib/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tevenfeng/dsh-plugin-omoslim.git"
  },
  "files": [
    "lib/index.js",
    "lib/cli.js",
    "lib/client.js",
    "cordis.patch.yml",
    "config/models.d/**",
    "config/presets/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "orchestrator",
    "subagent"
  ],
  "license": "MIT"
}
